# Sao chep file nay thanh .env de chay tren may, va dan cac gia tri nay
# vao muc Environment Variables tren Vercel khi deploy.
# KHONG BAO GIO commit file .env that len GitHub.

# Khoa API cua nha cung cap mo hinh AI.
# Chi duoc doc o phia may chu (api/score.js), khong bao gio gui xuong trinh duyet.
ANTHROPIC_API_KEY=dan-khoa-that-vao-day

# Model dung de cham diem. Haiku re va du nhanh cho MVP.
SCORING_MODEL=claude-haiku-4-5-20251001

# Bat/tat lop AI. Dat false thi san pham chay hoan toan bang luat cung.
AI_ENABLED=true
